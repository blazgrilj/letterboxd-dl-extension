{
  "manifest_version": 3,

  "name": "Letterboxd DL Extension",
  "description": "Adds Download and Watch buttons with source lists and shows release dates on Letterboxd.",
  "version": "2.0.0",

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "*://letterboxd.com/*",
    "*://www.dvdsreleasedates.com/*"
  ],

  "background": {
    "service_worker": "release_dates_service.js"
  },

  "content_scripts": [
    {
      "matches": ["*://letterboxd.com/film/*"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
