{
  "manifest_version": 3,

  "name": "Letterboxd DL Extension",
  "description": "Adds Download and Watch buttons with source lists and shows release dates on Letterboxd.",
  "version": "2.1.0",

  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],

  "host_permissions": [
    "*://letterboxd.com/*",
    "*://www.dvdsreleasedates.com/*"
  ],

  "background": {
    "scripts": ["defaults.js", "background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["*://letterboxd.com/film/*"],
      "js": ["defaults.js", "content.js"]
    }
  ],

  "commands": {
    "open-download": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open the Download menu"
    },
    "open-watch": {
      "suggested_key": { "default": "Alt+Shift+W" },
      "description": "Open the Watch menu"
    }
  },

  "action": {
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.4"
    }
  }
}
